FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Copy and run the setup script. The script installs all C++ dependencies
# (including absl, gRPC, RocksDB) into /usr/local and cleans up build
# artifacts in the same layer to keep the image small.
COPY common/setup-ubuntu20.sh /tmp/setup-ubuntu20.sh
RUN bash /tmp/setup-ubuntu20.sh \
  && rm -f /tmp/setup-ubuntu20.sh \
  && rm -rf /var/lib/apt/lists/* /root/.cache/pip \
  && apt-get clean

# Set default compilers.
ENV CC=/usr/bin/gcc-11
ENV CXX=/usr/bin/g++-11

WORKDIR /velox4j
